# Copy this file to .env and fill in your own keys.
# All three are optional -- the pipeline degrades gracefully when a key is
# missing, and --dry-run needs none of them.

# Required only for the Drafter stage (personalized copy generation and the
# affiliation fact-checker). Without it, run with --dry-run.
ANTHROPIC_API_KEY=

# Optional. Used as the last step of the Scout stage's email-finding
# waterfall. If unset, that step is skipped.
HUNTER_API_KEY=

# Optional. Reserved for future Scout enrichment (e.g. a search API). Not
# required by the current waterfall, which uses a keyless web-search
# endpoint.
GOOGLE_API_KEY=
